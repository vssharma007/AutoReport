<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ title }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; max-width: 900px;
         margin: 40px auto; color: #1a1a1a; line-height: 1.5; }
  h1 { border-bottom: 3px solid #2563eb; padding-bottom: 10px; }
  h2 { color: #2563eb; margin-top: 40px; }
  table { border-collapse: collapse; width: 100%; margin: 16px 0; }
  th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
  th { background: #f1f5f9; }
  .chart { text-align: center; margin: 20px 0; }
  .chart img { max-width: 100%; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
  .meta { color: #666; font-size: 0.9em; }
</style>
</head>
<body>
  <h1>{{ title }}</h1>
  <p class="meta">Generated {{ generated_at }}</p>

  {% for section in sections %}
    <h2>{{ section.name }}</h2>
    {% if section.table_html %}
      {{ section.table_html | safe }}
    {% endif %}
    {% if section.chart_b64 %}
      <div class="chart">
        <img src="data:image/png;base64,{{ section.chart_b64 }}" alt="{{ section.name }}">
      </div>
    {% endif %}
  {% endfor %}
</body>
</html>
